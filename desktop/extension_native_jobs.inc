 dl_agent_scheduler *queue=dl_agent_scheduler_open(s->db,"local",2);valid=queue&&dl_agent_enqueue(queue,&task)==DL_SCHED_OK;dl_agent_scheduler_close(queue);free(text);
 q=prep(s,"UPDATE extension_agent_jobs SET state=? WHERE job=?");if(q){bind(q,1,valid?"admitted":"rejected");bind(q,2,job);}if(!step(q))return fail("native_followup_finalization_unavailable");if(!valid){int clean=sql(s,"BEGIN IMMEDIATE");if(clean){q=prep(s,"UPDATE extension_agent_inputs SET job='' WHERE job=? AND kind='inject' AND status='queued'");if(q)bind(q,1,job);clean=step(q);}if(clean){q=prep(s,"UPDATE extension_agent_inputs SET status='cancelled' WHERE job=? AND kind='followup' AND status='queued'");if(q)bind(q,1,job);clean=step(q);}if(clean)clean=sql(s,"COMMIT");if(!clean)sql(s,"ROLLBACK");return fail(clean?"native_followup_enqueue_failed":"native_followup_cleanup_required");}
 J *data=json_object_new_object();json_object_object_add(data,"job",json_object_new_string(job));json_object_object_add(data,"messageId",json_object_new_string(mid));return reply(1,NULL,data);
}

static int native_jobs_receipt(dc_store *s,const char *call,J *response){
 J *body=get(response,"body"),*value=get(body,"value");int status=json_object_get_int(get(response,"status"));int success=status>=200&&status<300&&json_object_get_boolean(get(body,"ok"));
 sqlite3_stmt *q=prep(s,"SELECT job,chat,message FROM extension_agent_jobs WHERE call=? AND state='admitted'");if(q)bind(q,1,call);J *rows=json_object_new_array();int rc=SQLITE_ERROR;while(q&&(rc=sqlite3_step(q))==SQLITE_ROW){J *row=json_object_new_object();const char *keys[]={"job","chat","message"};for(int i=0;i<3;i++)json_object_object_add(row,keys[i],json_object_new_string((const char*)sqlite3_column_text(q,i)));json_object_array_add(rows,row);}sqlite3_finalize(q);int ok=rc==SQLITE_DONE;
 for(size_t i=0;ok&&i<json_object_array_length(rows);i++){J *row=json_object_array_get_idx(rows,i);int accepted=success&&((json_object_get_boolean(get(value,"accepted"))&&eq(str(value,"messageId"),str(row,"message")))||eq(str(value,"childId"),str(row,"chat")));
  q=prep(s,"UPDATE extension_agent_jobs SET state=CASE WHEN ?=1 AND EXISTS(SELECT 1 FROM extension_native_effects e WHERE e.call=extension_agent_jobs.call AND e.sequence=extension_agent_jobs.effect_sequence AND e.method='agent.followup' AND e.status='reported') THEN 'ready' ELSE 'rejected' END WHERE job=? AND state='admitted'");if(q){sqlite3_bind_int(q,1,accepted);bind(q,2,str(row,"job"));}ok=step(q);
 }json_object_put(rows);return ok;
}
