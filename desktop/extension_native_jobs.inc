/* Durable native model authority for SDK followups. JavaScript only admits a
 * job; the native host supplies credentials, executor and per-tool approvals. */
static int native_jobs_revoke(dc_store *s,const char *source,const char *package){
 sqlite3_stmt *q=prep(s,"SELECT a.job FROM extension_agent_jobs a JOIN agent_jobs j ON j.id=a.job WHERE a.source=? AND a.package=? AND j.state IN('queued','running','waiting')");if(q){bind(q,1,source);bind(q,2,package);}J *ids=json_object_new_array();int rc=SQLITE_ERROR;while(q&&(rc=sqlite3_step(q))==SQLITE_ROW)json_object_array_add(ids,json_object_new_string((const char*)sqlite3_column_text(q,0)));sqlite3_finalize(q);if(rc!=SQLITE_DONE){json_object_put(ids);return 0;}
 q=prep(s,"UPDATE extension_agent_jobs SET state='revoked' WHERE source=? AND package=? AND state IN('preparing','admitted','ready')");if(q){bind(q,1,source);bind(q,2,package);}int valid=step(q);if(valid&&json_object_array_length(ids)){dl_agent_scheduler *queue=dl_agent_scheduler_open(s->db,"local",2);if(!queue)valid=0;for(size_t i=0;valid&&i<json_object_array_length(ids);i++)valid=dl_agent_cancel(queue,json_object_get_string(json_object_array_get_idx(ids,i)))==DL_SCHED_OK;dl_agent_scheduler_close(queue);}json_object_put(ids);return valid;
}
static int native_agent_ready_unlocked(dc_store *s,const char *job){
 sqlite3_stmt *q=prep(s,"SELECT a.source,a.package,a.version,a.instance,a.config_hash,a.registry_revision,c.status,a.state,e.status FROM extension_agent_jobs a LEFT JOIN extension_calls c ON c.id=a.call LEFT JOIN extension_native_effects e ON e.call=a.call AND e.sequence=a.effect_sequence AND e.method='agent.followup' WHERE a.job=?");if(q)bind(q,1,job);int rc=q?sqlite3_step(q):SQLITE_ERROR;if(rc==SQLITE_DONE){sqlite3_finalize(q);return 1;}if(rc!=SQLITE_ROW){sqlite3_finalize(q);return 0;}
 char source[257],package[257],version[257],instance[65],hash[65];char *dest[]={source,package,version,instance,hash};size_t sizes[]={sizeof source,sizeof package,sizeof version,sizeof instance,sizeof hash};int valid=1;for(int i=0;i<5;i++){const char *v=(const char*)sqlite3_column_text(q,i);if(!v||strlen(v)>=sizes[i]){valid=0;break;}snprintf(dest[i],sizes[i],"%s",v);}int64_t revision=sqlite3_column_int64(q,5);valid=valid&&eq((const char*)sqlite3_column_text(q,6),"reported")&&eq((const char*)sqlite3_column_text(q,7),"ready")&&eq((const char*)sqlite3_column_text(q,8),"reported");sqlite3_finalize(q);if(!valid)return 0;
 char identity[65];package_identity(source,package,identity);J *active=get(state(s)->active,identity);if(!eq(str(active,"version"),version)||!eq(str(active,"instance"),instance))return 0;
 q=prep(s,"SELECT COALESCE((SELECT config FROM extension_configuration WHERE source=?1 AND package=?2 AND version=?3),'{}'),(SELECT revision FROM configuration_registry WHERE singleton=1),EXISTS(SELECT 1 FROM extension_bindings b JOIN extension_versions v ON v.source=b.source AND v.package=b.package AND v.version=b.version WHERE b.source=?1 AND b.package=?2 AND b.version=?3 AND b.enabled=1 AND v.quarantined=0 AND b.runtime_instance=?4)");if(q){bind(q,1,source);bind(q,2,package);bind(q,3,version);bind(q,4,instance);}char current[65]="";if(q&&sqlite3_step(q)==SQLITE_ROW){const char *raw=(const char*)sqlite3_column_text(q,0);if(raw)dc_sha256(raw,strlen(raw),current);valid=eq(current,hash)&&sqlite3_column_int64(q,1)==revision&&sqlite3_column_int(q,2);}else valid=0;sqlite3_finalize(q);return valid;
}
int dc_extensions_agent_ready(dc_store *s,const char *job){void *scope=dc_extensions_scope_enter(s);if(!scope)return 0;int ready=native_agent_ready_unlocked(s,job);dc_extensions_scope_leave(scope);return ready;}
static char *native_input_text(J *message,size_t cap){
 J *content=get(message,"content");if(!json_object_is_type(content,json_type_array))return NULL;size_t size=1;
 for(size_t i=0;i<json_object_array_length(content);i++){J *block=json_object_array_get_idx(content,i);const char *value=str(block,"text");if(!eq(str(block,"type"),"text")||!value||strlen(value)>cap-size)return NULL;size+=strlen(value);}
 char *out=malloc(size);if(!out)return NULL;size_t offset=0;for(size_t i=0;i<json_object_array_length(content);i++){const char *value=str(json_object_array_get_idx(content,i),"text");size_t n=strlen(value);memcpy(out+offset,value,n);offset+=n;}out[offset]=0;return out;
}
static J *native_followup(dc_store *s,J *args,const char *chat,const char *call,const char *source,const char *package,const char *version,const char *instance,int64_t sequence){
 J *message=get(args,"message");const char *mid=str(message,"id");char *text=native_input_text(message,16385);if(!mid||!*mid||strlen(mid)>128||!eq(str(message,"role"),"user")||!eq(str(get(message,"source"),"kind"),"user")||!text||!*text){free(text);return fail("native_followup_content_invalid");}
 sqlite3_stmt *q=prep(s,"SELECT n.operation,p.model,p.project,r.revision,COALESCE((SELECT config FROM extension_configuration WHERE source=?3 AND package=?4 AND version=?5),'{}') FROM extension_native_scopes n JOIN chat_properties p ON p.chat=?2 JOIN configuration_registry r ON r.singleton=1 WHERE n.call=?1 AND p.archived=0 AND (n.operation='interactive-session' OR EXISTS(SELECT 1 FROM extension_agent_sessions a WHERE a.chat=p.chat))");if(q){bind(q,1,call);bind(q,2,chat);bind(q,3,source);bind(q,4,package);bind(q,5,version);}char model[65]="",project[65]="",config_hash[65]="";int64_t revision=0;int valid=q&&sqlite3_step(q)==SQLITE_ROW&&(eq((const char*)sqlite3_column_text(q,0),"interactive-agent")||eq((const char*)sqlite3_column_text(q,0),"interactive-session"));if(valid){const char *m=(const char*)sqlite3_column_text(q,1),*p=(const char*)sqlite3_column_text(q,2),*config=(const char*)sqlite3_column_text(q,4);valid=m&&*m&&strlen(m)<sizeof model&&p&&strlen(p)<sizeof project&&config;if(valid){snprintf(model,sizeof model,"%s",m);snprintf(project,sizeof project,"%s",p);revision=sqlite3_column_int64(q,3);dc_sha256(config,strlen(config),config_hash);}}sqlite3_finalize(q);if(!valid){free(text);return fail("native_model_or_interactive_grant_required");}
 J *check=json_object_new_object();json_object_object_add(check,"op",json_object_new_string("config.model"));json_object_object_add(check,"id",json_object_new_string(model));json_object_object_add(check,"revision",json_object_new_int64(revision));J *configured=dc_config_request(s,check);valid=json_object_get_boolean(get(configured,"ok"));json_object_put(configured);json_object_put(check);if(!valid){free(text);return fail("native_model_configuration_changed");}
 const char *body=json_object_to_json_string_ext(message,JSON_C_TO_STRING_PLAIN);if(strlen(body)>65536){free(text);return fail("native_agent_input_exceeds_limit");}char digest[65],identity[1024],hash[65],job[65];dc_sha256(body,strlen(body),digest);snprintf(identity,sizeof identity,"%s:%s:%s:%s",source,package,chat,mid);dc_sha256(identity,strlen(identity),hash);snprintf(job,sizeof job,"sdk-%.48s",hash);
 q=prep(s,"SELECT request_hash,state,call FROM extension_agent_jobs WHERE job=?");if(q)bind(q,1,job);int rc=q?sqlite3_step(q):SQLITE_ERROR;if(rc==SQLITE_ROW){int same=eq((const char*)sqlite3_column_text(q,0),digest)&&eq((const char*)sqlite3_column_text(q,1),"admitted")&&eq((const char*)sqlite3_column_text(q,2),call);sqlite3_finalize(q);free(text);if(!same)return fail("native_followup_exists_review_required");J *data=json_object_new_object();json_object_object_add(data,"job",json_object_new_string(job));return reply(1,NULL,data);}sqlite3_finalize(q);if(rc!=SQLITE_DONE){free(text);return fail("native_followup_storage_error");}
 q=prep(s,"SELECT count(*),COALESCE(sum(length(CAST(body AS BLOB))),0) FROM extension_agent_inputs WHERE chat=? AND status='queued'");if(q)bind(q,1,chat);valid=q&&sqlite3_step(q)==SQLITE_ROW&&sqlite3_column_int64(q,0)<64&&sqlite3_column_int64(q,1)+(sqlite3_int64)strlen(body)<=524288;sqlite3_finalize(q);if(!valid){free(text);return fail("native_agent_inbox_limit");}
 q=prep(s,"SELECT body FROM extension_agent_inputs WHERE chat=? AND kind='inject' AND status='queued' AND job='' ORDER BY rowid");if(q)bind(q,1,chat);size_t total=strlen(text)+40;
 while(q&&(rc=sqlite3_step(q))==SQLITE_ROW){const char *raw=(const char*)sqlite3_column_text(q,0);J *injected=raw?dunlin_json_parse(raw,strlen(raw)):NULL;char *plain=native_input_text(injected,65536);json_object_put(injected);if(!plain||total>65534||strlen(plain)>65534-total){free(plain);valid=0;break;}total+=strlen(plain)+2;free(plain);}if(rc!=SQLITE_DONE)valid=0;sqlite3_finalize(q);if(!valid){free(text);return fail("native_agent_context_exceeds_limit");}
 J *workspace=dc_chat_workspace_view(s,chat);dl_agent_job task={0};valid=json_object_get_boolean(get(workspace,"available"));if(valid)snprintf(task.resource,sizeof task.resource,"%s:%s",str(workspace,"device"),str(workspace,"inode"));json_object_put(workspace);if(!valid){free(text);return fail("native_agent_workspace_unavailable");}
 if(!*project){dc_sha256(chat,strlen(chat),hash);snprintf(project,sizeof project,"native-%.48s",hash);}snprintf(task.id,sizeof task.id,"%s",job);snprintf(task.chat,sizeof task.chat,"%s",chat);snprintf(task.project,sizeof task.project,"%s",project);snprintf(task.model,sizeof task.model,"%s",model);task.task=text;task.write_access=1;
 valid=sql(s,"BEGIN IMMEDIATE");if(valid){q=prep(s,"INSERT INTO extension_agent_jobs(job,chat,message,call,source,package,version,instance,config_hash,registry_revision,request_hash,state,effect_sequence) VALUES(?,?,?,?,?,?,?,?,?,?,?,'preparing',?)");if(q){const char *v[]={job,chat,mid,call,source,package,version,instance,config_hash};for(int i=0;i<9;i++)bind(q,i+1,v[i]);sqlite3_bind_int64(q,10,revision);bind(q,11,digest);sqlite3_bind_int64(q,12,sequence);}valid=step(q);}
 if(valid){q=prep(s,"INSERT INTO extension_agent_inputs(chat,id,kind,body,call,job) VALUES(?,?,'followup',?,?,?)");if(q){bind(q,1,chat);bind(q,2,mid);bind(q,3,body);bind(q,4,call);bind(q,5,job);}valid=step(q);}
 if(valid){q=prep(s,"UPDATE extension_agent_inputs SET job=? WHERE chat=? AND kind='inject' AND status='queued' AND job=''");if(q){bind(q,1,job);bind(q,2,chat);}valid=step(q);}
