/* Managed registry installs: C performs hash verification and stages an
 * immutable version before presenting a native, one-use activation consent. */
static const char *const market_recipes[][2]={
 {"dshmarket","https://github.com/dsh-market/dsh-market"},
 {"dsh-better-sidebar","https://github.com/omdsh-dev/DSH-better-sidebar"},
 {"dsh-image-gen","https://github.com/shanliuling/dsh-image-gen"},
 {"dsh-checkpoint-rewind","https://github.com/PerryLink/dsh-checkpoint-rewind"},
 {"dsh-catppuccin","https://github.com/zhijun-dai/Catppuccin-dsh-theme"},
 {"dsh-project-manager","https://github.com/hoyyang/dsh-project-manager"}
};
static const char *market_repo(const char *name){for(size_t i=0;i<sizeof market_recipes/sizeof *market_recipes;i++)if(eq(name,market_recipes[i][0]))return market_recipes[i][1];return NULL;}
static J *market_install_policy(void){
 J *policy=json_object_new_object(),*rows=json_object_new_array();json_object_object_add(policy,"available",json_object_new_boolean(1));json_object_object_add(policy,"mode",json_object_new_string("native"));json_object_object_add(policy,"repositories",rows);
 // Market itself is upgraded only from the native owner settings.
 for(size_t i=1;i<sizeof market_recipes/sizeof *market_recipes;i++)json_object_array_add(rows,json_object_new_string(market_recipes[i][1]));return policy;
}
static J *market_catalog(dc_store *s,const char *op,const char *repo,const char *name,const char *version,const dc_hooks *hooks){J *r=json_object_new_object();json_object_object_add(r,"op",json_object_new_string(op));json_object_object_add(r,"repository",json_object_new_string(repo));json_object_object_add(r,"package",json_object_new_string(name));if(version)json_object_object_add(r,"version",json_object_new_string(version));J *out=dc_catalog_request(s,r,hooks);json_object_put(r);return out;}
static int market_install_consent(dc_store *s,const char *call,const char *name,const char *from,const char *to,const char *digest,const dc_hooks *hooks){
 J *review=json_object_new_object(),*question=json_object_new_object(),*options=json_object_new_array();json_object_object_add(review,"package",json_object_new_string(name));json_object_object_add(review,"version",json_object_new_string(to));json_object_object_add(review,"question",question);json_object_object_add(question,"id",json_object_new_string("managed-install"));json_object_object_add(question,"question",json_object_new_string("信任并启用这个插件版本？"));char detail[2048];snprintf(detail,sizeof detail,"%s\n%s → %s\n内容摘要 SHA-256: %s\n\n下载摘要已核对，但不代表此版本的功能已验证，请谨慎启用。此插件在独立 Node 兼容环境中运行，拥有宿主用户的文件与网络权限。模型工具仍须遵循聊天授权。升级可能改变插件行为或使旧配置不兼容；启用失败时将尝试恢复原版本。取消后原版本保持不变，下载的新版本保持未启用。",name,from&&*from?from:"未安装",to,digest);json_object_object_add(question,"detail",json_object_new_string(detail));json_object_object_add(question,"options",options);const char *labels[]={"仅允许这次启用","取消"};for(size_t i=0;i<2;i++){J *o=json_object_new_object();json_object_object_add(o,"label",json_object_new_string(labels[i]));json_object_array_add(options,o);}
 const char *raw=json_object_to_json_string_ext(review,JSON_C_TO_STRING_PLAIN);char hash[65];dc_sha256(raw,strlen(raw),hash);int allowed=hooks&&hooks->approve&&hooks->approve(hooks->user,"extension.confirm",raw);if(hooks&&hooks->cancelled&&hooks->cancelled(hooks->user))allowed=0;sqlite3_stmt *q=prep(s,"INSERT INTO extension_questions(call,id,question_hash,decision) VALUES(?,'managed-install',?,?)");if(q){bind(q,1,call);bind(q,2,hash);bind(q,3,allowed?"allowed_once":"denied");}int recorded=step(q);json_object_put(review);return allowed&&recorded;
}
static J *market_install_action(dc_store *s,const char *url,J *body,const char *call,const dc_hooks *hooks){
 int update=eq(url,"/dsh-market/update");const char *name=str(body,"name"),*repo=NULL;if(update)repo=market_repo(name);else{const char *input=str(body,"url");for(size_t i=0;i<sizeof market_recipes/sizeof *market_recipes;i++)if(eq(input,market_recipes[i][1])){name=market_recipes[i][0];repo=market_recipes[i][1];break;}}
 char stored_repo[2049]="";
 if(!repo&&update&&id(name)){
  sqlite3_stmt *q=prep(s,"SELECT json_extract(v.manifest,'$.repository') FROM extension_versions v JOIN extension_bindings b USING(source,package,version) WHERE b.package=? AND b.source='npm:'||b.package");if(q)bind(q,1,name);if(q&&sqlite3_step(q)==SQLITE_ROW&&sqlite3_column_type(q,0)==SQLITE_TEXT)snprintf(stored_repo,sizeof stored_repo,"%s",sqlite3_column_text(q,0));sqlite3_finalize(q);if(*stored_repo)repo=stored_repo;
 }else if(!repo&&!update&&id(name)&&strlen(name)<=214){repo=str(body,"url");}
 if(!repo||eq(name,"dshmarket"))return market_http_error(409,"缺少有效的包名或仓库地址；市场自身请从原生设置更新。");
 char source[257],old[257]="",target[257],upstream[128]="",digest[65]="";snprintf(source,sizeof source,"npm:%s",name);int enabled=0;J *old_config=NULL;
 sqlite3_stmt *q=prep(s,"SELECT b.source,b.version,b.enabled,coalesce(c.config,'{}') FROM extension_bindings b LEFT JOIN extension_configuration c ON c.source=b.source AND c.package=b.package AND c.version=b.version WHERE b.package=?");if(q)bind(q,1,name);int found=q?sqlite3_step(q):SQLITE_ERROR;if(found==SQLITE_ROW){const char *origin=(const char*)sqlite3_column_text(q,0);if(strcmp(origin,source)){sqlite3_finalize(q);return market_http_error(409,"当前包来自本地或其他来源，请在原生插件设置选择该来源的版本；市场不会覆盖其他来源。");}snprintf(old,sizeof old,"%s",sqlite3_column_text(q,1));enabled=sqlite3_column_int(q,2);const char *raw=(const char*)sqlite3_column_text(q,3);old_config=dunlin_json_parse(raw,strlen(raw));if(sqlite3_step(q)!=SQLITE_DONE){sqlite3_finalize(q);json_object_put(old_config);return market_http_error(409,"同名插件有多个来源，请先在原生设置选择来源。");}}else if(found!=SQLITE_DONE){sqlite3_finalize(q);return market_http_error(500,"storage_error");}sqlite3_finalize(q);if(update&&!*old){json_object_put(old_config);return market_http_error(404,"plugin_not_installed");}
 const char *wanted=update?str(body,"compatVersion"):str(body,"version");if(!wanted&&update)wanted=str(body,"eligibleVersion");if(wanted){if(!*wanted||strlen(wanted)>=sizeof upstream||strspn(wanted,"0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz.-+")!=strlen(wanted)){json_object_put(old_config);return market_http_error(400,"invalid_version");}snprintf(upstream,sizeof upstream,"%s",wanted);}else{J *versions=market_catalog(s,"catalog.npm.versions",repo,name,NULL,hooks);const char *latest=json_object_get_string(json_object_array_get_idx(get(versions,"data"),0));if(json_object_get_boolean(get(versions,"ok"))&&latest)snprintf(upstream,sizeof upstream,"%s",latest);json_object_put(versions);if(!*upstream){json_object_put(old_config);return market_http_error(502,"npm_metadata_download_failed");}}
 snprintf(target,sizeof target,"%s%sdunlin.3",upstream,strchr(upstream,'+')?".":"+");if(eq(old,target)&&(update||enabled)){json_object_put(old_config);J *body=json_object_new_object();json_object_object_add(body,"ok",json_object_new_boolean(1));json_object_object_add(body,"skipped",json_object_new_string("current"));return market_http_reply(200,body);}
 J *installed=market_catalog(s,"catalog.npm.install",repo,name,upstream,hooks);if(!json_object_get_boolean(get(installed,"ok"))){J *error=market_http_error(409,str(installed,"error")?str(installed,"error"):"managed_install_failed");json_object_put(installed);json_object_put(old_config);return error;}json_object_put(installed);
 q=prep(s,"SELECT digest FROM extension_versions WHERE source=? AND package=? AND version=? AND quarantined=0");if(q){bind(q,1,source);bind(q,2,name);bind(q,3,target);}if(q&&sqlite3_step(q)==SQLITE_ROW)snprintf(digest,sizeof digest,"%s",sqlite3_column_text(q,0));sqlite3_finalize(q);if(!*digest){json_object_put(old_config);return market_http_error(409,"extension_quarantined_or_missing");}
 if(!market_install_consent(s,call,name,old,target,digest,hooks)){json_object_put(old_config);return market_http_error(409,"已取消启用，已下载版本保持未启用，原版本未改变。");}
 J *r=json_object_new_object();json_object_object_add(r,"source",json_object_new_string(source));json_object_object_add(r,"package",json_object_new_string(name));json_object_object_add(r,"version",json_object_new_string(target));json_object_object_add(r,"enabled",json_object_new_boolean(1));json_object_object_add(r,"acceptHostPermissions",json_object_new_boolean(1));if(old_config)json_object_object_add(r,"config",json_object_get(old_config));J *activated=activate(s,r,hooks);int active=json_object_get_boolean(get(activated,"ok"));char error[512];snprintf(error,sizeof error,"%s",str(activated,"error")?str(activated,"error"):"activation_failed");json_object_put(activated);
 int rollback=0;if(!active&&*old){json_object_object_add(r,"version",json_object_new_string(old));json_object_object_add(r,"enabled",json_object_new_boolean(enabled));J *restored=activate(s,r,hooks);rollback=json_object_get_boolean(get(restored,"ok"));json_object_put(restored);}json_object_put(r);json_object_put(old_config);
 J *out=json_object_new_object();json_object_object_add(out,"ok",json_object_new_boolean(active));json_object_object_add(out,"name",json_object_new_string(name));json_object_object_add(out,"version",json_object_new_string(upstream));json_object_object_add(out,"reload",json_object_new_boolean(0));json_object_object_add(out,"restart",json_object_new_boolean(0));if(!active){json_object_object_add(out,"error",json_object_new_string(error));json_object_object_add(out,"rolledBack",json_object_new_boolean(rollback));}return market_http_reply(active?200:409,out);
}
