/* Live schema-backed settings use a durable C commit before changing the SDK
 * source. Other plugins retain their existing audited rebind contract. */
static J *client_settings_apply(dc_store *s,J *r,const dc_hooks *hooks){
 const char *source=str(r,"source"),*package=str(r,"package"),*version=str(r,"version"),*chat=str(r,"chat");J *config=get(r,"config");if(!json_object_is_type(config,json_type_object))return fail("invalid_extension_configuration");const char *raw=json_object_to_json_string_ext(config,JSON_C_TO_STRING_PLAIN);if(strlen(raw)>32768)return fail("invalid_extension_configuration");
 J *args=json_object_new_object();json_object_object_add(args,"config",json_object_get(config));J *validation=ui_host_call(s,source,package,version,chat,"ui.settings.validate",args,hooks);if(!json_object_get_boolean(get(validation,"ok"))){json_object_put(validation);json_object_put(args);return fail("invalid_live_extension_configuration");}int supported=json_object_get_boolean(get(get(get(validation,"data"),"data"),"supported"));json_object_put(validation);
 if(!supported){json_object_put(args);json_object_object_add(r,"enabled",json_object_new_boolean(1));json_object_object_add(r,"acceptHostPermissions",json_object_new_boolean(1));J *rebound=activate(s,r,hooks);if(!json_object_get_boolean(get(rebound,"ok")))return rebound;json_object_put(rebound);J *out=json_object_new_object();json_object_object_add(out,"rebound",json_object_new_boolean(1));return reply(1,NULL,out);}
 char hash[65],call[65]="";dc_sha256(raw,strlen(raw),hash);sqlite3_stmt *q=prep(s,"SELECT lower(hex(randomblob(16)))");if(q&&sqlite3_step(q)==SQLITE_ROW)snprintf(call,sizeof call,"%s",sqlite3_column_text(q,0));sqlite3_finalize(q);if(!*call||!sql(s,"BEGIN IMMEDIATE")){json_object_put(args);return fail("storage_error");}
 q=prep(s,"SELECT coalesce((SELECT config FROM extension_configuration WHERE source=? AND package=? AND version=?),'{}')");if(q){bind(q,1,source);bind(q,2,package);bind(q,3,version);}char actual[65]="";if(q&&sqlite3_step(q)==SQLITE_ROW){const char *before=(const char*)sqlite3_column_text(q,0);dc_sha256(before,strlen(before),actual);}sqlite3_finalize(q);if(!eq(actual,str(r,"expectedHash"))){sql(s,"ROLLBACK");json_object_put(args);return fail("extension_configuration_changed");}
 q=prep(s,"INSERT INTO extension_calls(id,source,package,version,method,args_hash,status) VALUES(?,?,?,?,'settings.apply',?,'running')");if(q){const char *v[]={call,source,package,version,hash};for(int i=0;i<5;i++)bind(q,i+1,v[i]);}int saved=step(q);
 if(saved){q=prep(s,"INSERT INTO extension_configuration(source,package,version,config) VALUES(?,?,?,?) ON CONFLICT(source,package,version) DO UPDATE SET config=excluded.config");if(q){bind(q,1,source);bind(q,2,package);bind(q,3,version);bind(q,4,raw);}saved=step(q);}
 if(saved)saved=sql(s,"COMMIT");if(!saved){sql(s,"ROLLBACK");json_object_put(args);return fail("invocation_audit_unavailable");}
 J *applied=ui_host_call(s,source,package,version,chat,"ui.settings.apply",args,hooks);json_object_put(args);int ok=json_object_get_boolean(get(applied,"ok"))&&json_object_get_boolean(get(get(get(applied,"data"),"data"),"supported"));
 if(!ok){char identity[65];package_identity(source,package,identity);extension_state *e=state(s);J *params=json_object_new_object();json_object_object_add(params,"id",json_object_new_string(identity));J *stopped=worker_request(s,e->dsh,"plugins.deactivate",params,NULL);json_object_put(params);if(!json_object_get_boolean(get(stopped,"ok")))host_fault(s,e,"node-dsh","settings_cleanup_failed");json_object_put(stopped);sqlite3_int64 fault_id=fault(s,source,package,version,"settings","live_settings_apply_failed");fault_diagnostic(s,fault_id,get(applied,"data"));}json_object_put(applied);
 q=prep(s,"UPDATE extension_calls SET status=?,finished=unixepoch() WHERE id=?");if(q){bind(q,1,ok?"completed":"reported_failure");bind(q,2,call);}if(!step(q)){host_fault(s,state(s),"node-dsh","settings_finalization_failed");return fail("settings_finalization_failed");}return ok?reply(1,NULL,json_object_get(config)):fail("live_settings_apply_failed");
}
