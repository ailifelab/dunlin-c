 for(size_t i=0;i<n;i++){unsigned char c=(unsigned char)text[i];if((c<32&&c!='\n'&&c!='\r'&&c!='\t')||c=='\\'||c=='@'||c=='<'){valid=0;break;}if(!comment&&c=='/'&&i+1<n&&text[i+1]=='*'){comment=1;i++;continue;}if(comment){if(c=='*'&&i+1<n&&text[i+1]=='/'){comment=0;i++;}continue;}if(c==' '||c=='\t'||c=='\r'||c=='\n')continue;compact[out++]=(char)(c>='A'&&c<='Z'?c+32:c);}
 compact[out]=0;valid=valid&&!comment&&!strstr(compact,"url(")&&!strstr(compact,"image-set(")&&!strstr(compact,"src(")&&!strstr(compact,"expression(")&&!strstr(compact,"behavior:")&&!strstr(compact,"-moz-binding");free(compact);return valid;
}
static int presentation_number(J *o,const char *key,double maximum){J *v=get(o,key);if(!json_object_is_type(v,json_type_double)&&!json_object_is_type(v,json_type_int))return 0;double n=json_object_get_double(v);return n>=0&&n<=maximum;}
static int presentation_valid(J *v){
 J *g=get(v,"glass");return json_object_is_type(v,json_type_object)&&json_object_object_length(v)==4&&presentation_css(get(v,"selectedCSS"))&&presentation_css(get(v,"globalCSS"))&&json_object_is_type(get(v,"glow"),json_type_boolean)&&json_object_is_type(g,json_type_object)&&json_object_object_length(g)==5&&json_object_is_type(get(g,"enabled"),json_type_boolean)&&(eq(str(g,"mode"),"mica")||eq(str(g,"mode"),"compat"))&&presentation_number(g,"blur",40)&&presentation_number(g,"frost",100)&&presentation_number(g,"brightness",100);
}
static J *presentation_read(dc_store *s){
 extension_state *e=state(s);J *rows=json_object_new_array();sqlite3_stmt *q=prep(s,"SELECT p.source,p.package,p.version,p.value FROM extension_presentations p JOIN extension_versions v ON v.source=p.source AND v.package=p.package AND v.version=p.version AND v.digest=p.digest JOIN extension_bindings b ON b.source=p.source AND b.package=p.package AND b.version=p.version WHERE b.enabled=1 AND v.quarantined=0 ORDER BY p.source,p.package");if(!q){json_object_put(rows);return fail("storage_error");}int rc;
 while((rc=sqlite3_step(q))==SQLITE_ROW){const char *source=(const char*)sqlite3_column_text(q,0),*package=(const char*)sqlite3_column_text(q,1),*version=(const char*)sqlite3_column_text(q,2);char identity[65];package_identity(source,package,identity);J *active=e?get(e->active,identity):NULL;if(!active||!eq(str(active,"version"),version)||!dc_worker_alive(e->dsh))continue;
  J *v=dunlin_json_parse((const char*)sqlite3_column_text(q,3),(size_t)sqlite3_column_bytes(q,3));if(!presentation_valid(v)){json_object_put(v);sqlite3_finalize(q);json_object_put(rows);return fail("invalid_saved_presentation");}json_object_object_add(v,"owner",json_object_new_string(identity));J *preferences=json_object_new_array();const char *names[]={"catppuccin-latte","catppuccin-frappe","catppuccin-macchiato","catppuccin-mocha"};for(size_t i=0;i<4;i++)json_object_array_add(preferences,json_object_new_string(names[i]));json_object_object_add(v,"preferences",preferences);json_object_array_add(rows,v);
 }sqlite3_finalize(q);if(rc!=SQLITE_DONE){json_object_put(rows);return fail("storage_error");}return reply(1,NULL,rows);
}
static J *presentation_write(dc_store *s,J *r){
 const char *source=str(r,"source"),*package=str(r,"package"),*version=str(r,"version"),*instance=str(r,"instance");if(!id(source)||!id(package)||!id(version)||!instance)return fail("invalid_presentation_owner");extension_state *e=state(s);char identity[65];package_identity(source,package,identity);J *active=e?get(e->active,identity):NULL;if(!active||!eq(str(active,"version"),version)||!eq(str(active,"instance"),instance)||!dc_worker_alive(e->dsh))return fail("stale_presentation_owner");
 sqlite3_stmt *q=prep(s,"SELECT v.path,v.files,v.manifest,v.digest FROM extension_versions v JOIN extension_bindings b ON b.source=v.source AND b.package=v.package AND b.version=v.version WHERE v.source=? AND v.package=? AND v.version=? AND v.quarantined=0 AND b.enabled=1");if(q){bind(q,1,source);bind(q,2,package);bind(q,3,version);}if(!q||sqlite3_step(q)!=SQLITE_ROW){sqlite3_finalize(q);return fail("presentation_owner_unavailable");}
 J *files=dunlin_json_parse((const char*)sqlite3_column_text(q,1),(size_t)sqlite3_column_bytes(q,1)),*manifest=dunlin_json_parse((const char*)sqlite3_column_text(q,2),(size_t)sqlite3_column_bytes(q,2));const char *path=(const char*)sqlite3_column_text(q,0);char *code=eq(package,"dsh-catppuccin")&&eq(str(manifest,"upstreamVersion"),"0.2.6")&&str(get(manifest,"client"),"entry")&&dc_package_verify(path,files)?dc_package_read_text(path,files,str(get(manifest,"client"),"entry")):NULL;char hash[65]="";if(code)dc_sha256(code,strlen(code),hash);free(code);char *digest=strdup((const char*)sqlite3_column_text(q,3));json_object_put(files);json_object_put(manifest);sqlite3_finalize(q);if(!digest)return fail("out_of_memory");if(!presentation_client(package,hash)){free(digest);return fail("presentation_client_unsupported");}
