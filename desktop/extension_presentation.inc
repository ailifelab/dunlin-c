/* Desktop-only appearance projection. Executable authority remains with the
 * verified, active owner; consumers receive CSS/typed hints, never JavaScript. */
#include "dunlin/compact/agent.h"
static int presentation_client(const char *package,const char *sha){
 return eq(package,"dsh-catppuccin")&&eq(sha,"85391d4838a8d861699fe5c55078d74d0f9feaafc6332c905ee9fb3cb368442b");
}
static int presentation_css(J *value){
 if(!json_object_is_type(value,json_type_string))return 0;const char *text=json_object_get_string(value);size_t n=(size_t)json_object_get_string_len(value);if(!n||n>65536||strlen(text)!=n||!ah_utf8_text(text,n))return 0;
