MACOSX_DEPLOYMENT_TARGET = 26.0
SDKROOT = macosx
SUPPORTED_PLATFORMS = macosx
ARCHS = arm64
SWIFT_VERSION = 5.0
PRODUCT_NAME = Dunlin Copilot
PRODUCT_BUNDLE_IDENTIFIER = org.dunlin.desktop
MARKETING_VERSION = 0.3.1
CURRENT_PROJECT_VERSION = 3
INFOPLIST_FILE = Configuration/Info.plist
GENERATE_INFOPLIST_FILE = NO
SWIFT_INCLUDE_PATHS = $(inherited) $(PROJECT_DIR)/Sources/CDesktop
LIBRARY_SEARCH_PATHS = $(inherited) $(PROJECT_DIR)/../../build/desktop/xcode-26-$(CONFIGURATION)
OTHER_LDFLAGS = $(inherited) -ldunlin-desktop -ldunlin -ldunlin-kernel $(PROJECT_DIR)/../../build/native-deps/media-current/lib/libcurl.a $(PROJECT_DIR)/../../build/native-deps/macos26/lib/libssl.a -framework SystemConfiguration -framework Security -framework CoreFoundation -framework CoreServices -lsqlite3 -lz $(PROJECT_DIR)/../../build/native-deps/macos26/lib/libjson-c.a $(PROJECT_DIR)/../../build/native-deps/macos26/lib/libcrypto.a
CODE_SIGN_STYLE = Automatic
CODE_SIGN_ENTITLEMENTS = Configuration/DunlinCopilot.entitlements
ENABLE_HARDENED_RUNTIME = YES
ENABLE_USER_SCRIPT_SANDBOXING = NO
COMBINE_HIDPI_IMAGES = YES
CLANG_ENABLE_MODULES = YES
SWIFT_EMIT_LOC_STRINGS = YES
// Team selection is intentionally left to Xcode Signing & Capabilities.
