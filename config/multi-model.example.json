{
  "workspace": "work",
  "session_dir": "sessions",
  "stream": true,
  "show_reasoning": true,
  "timeout_ms": 30000,
  "max_tokens": 512,
  "active_model": "local",
  "models": {
    "local": {
      "base_url": "http://127.0.0.1:8080/v1",
      "model": "replace-with-local-model",
      "protocol": "chat",
      "reasoning_effort": "default"
    },
    "responses": {
      "base_url": "https://api.openai.com/v1",
      "model": "replace-with-supported-responses-model",
      "key_env": "OPENAI_API_KEY",
      "protocol": "responses"
    },
    "messages": {
      "base_url": "https://api.anthropic.com/v1",
      "model": "replace-with-supported-messages-model",
      "key_env": "ANTHROPIC_API_KEY",
      "protocol": "anthropic"
    },
    "ollama": {
      "base_url": "http://127.0.0.1:11434/api",
      "model": "replace-with-installed-model",
      "protocol": "ollama"
    }
  }
}
